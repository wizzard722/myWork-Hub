# Kopieer naar .env en pas aan. Wachtwoorden en sleutels NOOIT in git.

# Domein van de hub; klanten krijgen <klant>.<HUB_DOMAIN>.
#   Ontwikkeling: localhost (https://acme.localhost met eigen certificaat van Caddy)
HUB_DOMAIN=localhost
# TLS: internal (ontwikkeling, eigen CA) of ondemand (productie, Let's Encrypt per subdomein)
HUB_TLS=internal
ACME_EMAIL=admin@example.com

HUB_ENVIRONMENT=development
# Ed25519-sleutel (PEM) voor tokens; leeg = tijdelijke sleutel (alleen ontwikkeling).
HUB_JWT_PRIVATE_KEY=
# Mogen nieuwe klanten zichzelf aanmelden?
HUB_ALLOW_SIGNUP=false

POSTGRES_USER=mywork
POSTGRES_PASSWORD=change-me
POSTGRES_DB=mywork
REDIS_PASSWORD=change-me-too

# LLM-assistent (optioneel). Leeg = assistent uit.
ANTHROPIC_API_KEY=
HUB_LLM_MODEL=claude-opus-5-5
