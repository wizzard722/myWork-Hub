# Kopieer naar .env en pas aan.
HUB_ENVIRONMENT=development
HUB_PUBLIC_URL=http://localhost:8080
# Klanten via subdomein: <klant>.<HUB_BASE_DOMAIN>
HUB_BASE_DOMAIN=localhost
HUB_COOKIE_SECURE=false
# Ed25519-sleutel (PEM) voor tokens; leeg = tijdelijke sleutel (alleen ontwikkeling).
HUB_JWT_PRIVATE_KEY=
# Mogen nieuwe klanten zichzelf aanmelden?
HUB_ALLOW_SIGNUP=false
POSTGRES_USER=mywork
POSTGRES_PASSWORD=change-me
POSTGRES_DB=mywork
